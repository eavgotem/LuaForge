--- src/components/Hero.tsx (原始)


+++ src/components/Hero.tsx (修改后)
import { useEffect, useMemo, useRef, useState, type CSSProperties } from "react";
import { NAV_LINKS, SCENARIOS, genericScenario, type Scenario } from "../data";
import { usePrefersReducedMotion, useScramble, useTyped } from "../hooks";
import { CodeBlock } from "../highlight";
import { Chip } from "../ui";
import { ArrowRight, Bolt, CheckCircle, LogoMark } from "../icons";

/* ============================= NAV ============================= */

function Nav() {
  const [scrolled, setScrolled] = useState(false);
  const [progress, setProgress] = useState(0);
  const [open, setOpen] = useState(false);

  useEffect(() => {
    const onScroll = () => {
      const y = window.scrollY;
      setScrolled(y > 12);
      const max = document.documentElement.scrollHeight - window.innerHeight;
      setProgress(max > 0 ? Math.min(1, y / max) : 0);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    return () => window.removeEventListener("scroll", onScroll);
  }, []);

  return (
    <header
      className={`fixed inset-x-0 top-0 z-50 transition-all duration-300 ${
        scrolled ? "border-b border-line-soft bg-ink-900/90 backdrop-blur-md" : "bg-transparent"
      }`}
    >
      <div
        className="absolute left-0 top-0 h-[2px] bg-gradient-to-r from-amber via-ember to-mint transition-[width] duration-150"
        style={{ width: `${progress * 100}%` }}
      />
      <nav className="wrap flex h-16 items-center justify-between gap-4">
        <a href="#top" className="group flex items-center gap-2.5">
          <span className="transition-transform duration-300 group-hover:rotate-[8deg]">
            <LogoMark size={30} />
          </span>
          <span className="font-display text-[15px] font-bold tracking-tight text-fog">
            Luau<span className="text-amber">Forge</span>
          </span>
          <span className="hidden rounded border border-mint/30 bg-mint/10 px-1.5 py-0.5 font-mono text-[9px] font-bold tracking-[0.14em] text-mint sm:inline">
            FREE
          </span>
        </a>

        <div className="hidden items-center gap-7 lg:flex">
          {NAV_LINKS.map((l) => (
            <a key={l.href} href={l.href} className="navlink text-[13px] font-medium text-mute transition-colors hover:text-fog">
              {l.label}
            </a>
          ))}
        </div>

        <div className="flex items-center gap-3">
          <a
            href="#install"
            className="group hidden items-center gap-2 rounded-md bg-amber px-4 py-2 text-[13px] font-bold text-ink-950 transition-all duration-200 hover:bg-fog hover:shadow-[0_0_28px_rgba(255,180,84,0.35)] active:scale-[0.97] sm:inline-flex"
          >
            Install free
            <ArrowRight size={15} className="transition-transform duration-200 group-hover:translate-x-1" />
          </a>
          <button
            type="button"
            aria-label="Toggle menu"
            onClick={() => setOpen((v) => !v)}
            className="flex h-10 w-10 items-center justify-center rounded-md border border-line text-mute transition-colors hover:text-amber lg:hidden"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round">
              {open ? <path d="m6 6 12 12M18 6 6 18" /> : <path d="M4 7h16M4 12h16M4 17h10" />}
            </svg>
          </button>
        </div>
      </nav>
      {open && (
        <div className="border-t border-line-soft bg-ink-900/95 px-5 py-4 backdrop-blur-md lg:hidden">
          {NAV_LINKS.map((l) => (
            <a
              key={l.href}
              href={l.href}
              onClick={() => setOpen(false)}
              className="block py-2.5 text-[14px] font-medium text-mute transition-colors hover:text-amber"
            >
              {l.label}
            </a>
          ))}
          <a href="#install" onClick={() => setOpen(false)} className="mt-2 block rounded-md bg-amber px-4 py-2.5 text-center text-[14px] font-bold text-ink-950">
            Install free
          </a>
        </div>
      )}
    </header>
  );
}

/* ========================= STUDIO DEMO ========================= */

const FLOATERS = [
  { text: "task.spawn()", top: "8%", left: "-4%", rot: "-6deg", dur: "8s", color: "text-mint/50" },
  { text: ":GetAsync()", top: "22%", left: "86%", rot: "5deg", dur: "10s", color: "text-amber/50" },
  { text: "CFrame.new", top: "64%", left: "-7%", rot: "4deg", dur: "9s", color: "text-aqua/50" },
  { text: "Instance.new", top: "80%", left: "82%", rot: "-5deg", dur: "11s", color: "text-rose/40" },
  { text: ":Connect()", top: "44%", left: "94%", rot: "7deg", dur: "8.5s", color: "text-mint/40" },
  { text: "--!strict", top: "2%", left: "58%", rot: "-3deg", dur: "9.5s", color: "text-amber/40" },
];

function StudioDemo() {
  const reduced = usePrefersReducedMotion();
  const [scenario, setScenario] = useState<Scenario>(SCENARIOS[0]);
  const [input, setInput] = useState("");
  const [logs, setLogs] = useState<string[]>(["⚒ LuauForge panel ready — 0 tokens, as always", "context: ServerScriptService ▸ listening to selection"]);
  const [inserted, setInserted] = useState(false);
  const [copied, setCopied] = useState(false);

  const { typed, done } = useTyped(scenario.code, 2, reduced);
  const elapsed = useMemo(() => (scenario.code.length / 940).toFixed(2), [scenario]);
  const lineCount = useMemo(() => scenario.code.split("\n").length, [scenario]);

  const prevDone = useRef(false);
  useEffect(() => {
    if (done && !prevDone.current) {
      setLogs((l) => [...l.slice(-2), `✓ compiled clean · ${lineCount} lines · 0 warnings`]);
    }
    prevDone.current = done;
  }, [done, lineCount]);

  const pushLog = (line: string) => setLogs((l) => [...l.slice(-2), line]);

  const selectScenario = (s: Scenario) => {
    setScenario(s);
    setInserted(false);
    setCopied(false);
    prevDone.current = false;
    pushLog(`> ${s.prompt.slice(0, 52)}${s.prompt.length > 52 ? "…" : ""}`);
  };

  const submit = () => {
    const q = input.trim();
    if (!q) return;
    const words = q.toLowerCase();
    const match = SCENARIOS.find((s) => s.keywords.some((k) => words.includes(k)));
    selectScenario(match ?? genericScenario(q));
    setInput("");
  };

  const insert = () => {
    if (!done || inserted) return;
    setInserted(true);
    pushLog(`✓ inserted into ${scenario.location} as ${scenario.file}`);
  };

  const copy = async () => {
    try {
      await navigator.clipboard.writeText(scenario.code);
    } catch {
      /* clipboard unavailable */
    }
    setCopied(true);
    window.setTimeout(() => setCopied(false), 1800);
  };

  return (
    <div className="relative">
      {/* window chrome */}
      <div className="overflow-hidden rounded-lg border border-line bg-ink-850 shadow-[0_30px_80px_-20px_rgba(4,6,12,0.9)]">
        {/* title bar */}
        <div className="flex items-center gap-3 border-b border-line-soft bg-ink-800 px-4 py-2.5">
          <span className="flex gap-1.5">
            <i className="h-2.5 w-2.5 rounded-full bg-rose/80" />
            <i className="h-2.5 w-2.5 rounded-full bg-amber/80" />
            <i className="h-2.5 w-2.5 rounded-full bg-mint/80" />
          </span>
          <span className="truncate font-mono text-[11px] text-dim">Roblox Studio — obby_tycoon_v17.rbxl</span>
          <span className="ml-auto hidden rounded border border-aqua/30 bg-aqua/10 px-2 py-0.5 font-mono text-[9px] font-bold uppercase tracking-[0.14em] text-aqua sm:block">
            live demo · simulated
          </span>
        </div>

        {/* file tab row */}
        <div className="flex items-center gap-1 border-b border-line-soft bg-ink-850 px-3 pt-2">
          <div className="flex items-center gap-2 rounded-t-md border border-b-0 border-line bg-ink-950 px-3 py-1.5 font-mono text-[11px] text-fog">
            <span className="text-amber">⌘</span>
            {scenario.file}.lua
          </div>
          <div className="px-3 py-1.5 font-mono text-[11px] text-dim">untitled.lua</div>
          <span className="ml-auto pb-1.5 font-mono text-[10px] text-dim">Luau</span>
        </div>

        <div className="grid md:grid-cols-[150px_1fr]">
          {/* explorer mini-panel */}
          <aside className="hidden border-r border-line-soft bg-ink-900/70 p-3 font-mono text-[10.5px] leading-[1.9] text-dim md:block">
            <p className="mb-1 text-[9px] font-bold uppercase tracking-[0.18em] text-mute">Explorer</p>
            <p>▾ Workspace</p>
            <p>▾ Players</p>
            <p>▾ ReplicatedStorage</p>
            <p className="text-mute">▾ ServerScriptService</p>
            {scenario.location.startsWith("ServerScriptService") && (
              <p className={`pl-3 transition-colors duration-300 ${inserted ? "text-mint" : "text-amber"}`}>
                {inserted ? "✓ " : "◌ "}
                {scenario.file}
              </p>
            )}
            <p>▾ StarterPlayer</p>
            {scenario.location.startsWith("StarterPlayer") && (
              <p className={`pl-3 transition-colors duration-300 ${inserted ? "text-mint" : "text-amber"}`}>
                {inserted ? "✓ " : "◌ "}
                {scenario.file}
              </p>
            )}
            <p>▸ Lighting</p>
            <p className="text-mute">▾ Workspace.LavaPads</p>
            {scenario.location.startsWith("Workspace") && (
              <p className={`pl-3 transition-colors duration-300 ${inserted ? "text-mint" : "text-amber"}`}>
                {inserted ? "✓ " : "◌ "}
                {scenario.file}
              </p>
            )}
          </aside>

          {/* code area */}
          <div className="bg-ink-950">
            <CodeBlock code={typed} cursor={!done} textClass="text-[11px] md:text-[11.5px]" className="max-h-[360px] min-h-[330px] p-3" />

            {/* action row */}
            <div className="flex flex-wrap items-center gap-2 border-t border-line-soft px-3 py-2.5">
              <button
                type="button"
                onClick={insert}
                disabled={!done || inserted}
                className={`inline-flex items-center gap-2 rounded-md px-3.5 py-1.5 text-[12px] font-bold transition-all duration-200 active:scale-[0.97] ${
                  inserted
                    ? "cursor-default bg-mint/15 text-mint"
                    : done
                      ? "bg-amber text-ink-950 hover:bg-fog hover:shadow-[0_0_22px_rgba(255,180,84,0.35)]"
                      : "cursor-wait bg-ink-700 text-dim"
                }`}
              >
                {inserted ? <CheckCircle size={14} /> : <Bolt size={14} />}
                {inserted ? "Inserted ✓" : done ? "Insert into Explorer" : "Forging…"}
              </button>
              <button
                type="button"
                onClick={copy}
                className="inline-flex items-center gap-2 rounded-md border border-line px-3.5 py-1.5 text-[12px] font-semibold text-mute transition-all duration-200 hover:border-amber/50 hover:text-amber active:scale-[0.97]"
              >
                {copied ? <CheckCircle size={14} className="text-mint" /> : <Bolt size={14} className="opacity-50" />}
                {copied ? "Copied" : "Copy source"}
              </button>
              <span className="ml-auto font-mono text-[10px] text-dim">
                {done ? `${lineCount} lines · ${elapsed}s` : `generating… ${typed.length}/${scenario.code.length}`}
              </span>
            </div>

            {/* console */}
            <div className="space-y-0.5 border-t border-line-soft bg-ink-900 px-3 py-2 font-mono text-[10.5px] leading-[1.8]">
              {logs.map((log, i) => (
                <p key={`${log}-${i}`} className={`riseline truncate ${log.startsWith("✓") ? "text-mint" : log.startsWith(">") ? "text-amber" : "text-dim"}`}>
                  {log}
                </p>
              ))}
            </div>
          </div>
        </div>

        {/* prompt bar */}
        <div className="border-t border-line bg-ink-800 p-3">
          <div className="mb-2.5 flex flex-wrap gap-1.5">
            {SCENARIOS.slice(0, 4).map((s) => (
              <button
                key={s.id}
                type="button"
                onClick={() => selectScenario(s)}
                className={`rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold transition-all duration-200 active:scale-[0.96] ${
                  scenario.id === s.id
                    ? "border-amber/60 bg-amber/15 text-amber"
                    : "border-line text-dim hover:border-amber/40 hover:text-mute"
                }`}
              >
                {s.chip}
              </button>
            ))}
          </div>
          <form
            onSubmit={(e) => {
              e.preventDefault();
              submit();
            }}
            className="flex items-center gap-2"
          >
            <span className="font-mono text-[13px] font-bold text-amber">›</span>
            <input
              value={input}
              onChange={(e) => setInput(e.target.value)}
              placeholder='Ask anything: "speed coil", "daily reward", "pet follow system"…'
              className="min-w-0 flex-1 bg-transparent font-mono text-[12.5px] text-fog placeholder:text-dim focus:outline-none"
            />
            <button
              type="submit"
              aria-label="Send prompt"
              className="group flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-amber text-ink-950 transition-all duration-200 hover:bg-fog hover:shadow-[0_0_22px_rgba(255,180,84,0.35)] active:scale-90"
            >
              <ArrowRight size={16} className="transition-transform duration-200 group-hover:translate-x-0.5" />
            </button>
          </form>
        </div>

        {/* status bar */}
        <div className="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-line-soft bg-ink-850 px-4 py-1.5 font-mono text-[10px] text-dim">
          <span className="flex items-center gap-1.5">
            <i className="pulseglow h-1.5 w-1.5 rounded-full bg-mint" />
            pool.luauforge.dev — connected
          </span>
          <span>model: luauforge-2-mini</span>
          <span className="text-amber">tokens used: 0</span>
          <span className="ml-auto hidden sm:inline">Ln {done ? lineCount : typed.split("\n").length}, Col 1 · UTF-8</span>
        </div>
      </div>
    </div>
  );
}

/* ============================= HERO ============================= */

export default function Hero() {
  const reduced = usePrefersReducedMotion();
  const [go, setGo] = useState(false);
  useEffect(() => {
    const t = window.setTimeout(() => setGo(true), 150);
    return () => window.clearTimeout(t);
  }, []);

  const l1 = useScramble("THE AI THAT", go, reduced);
  const l2 = useScramble("SPEAKS FLUENT", go, reduced);
  const l3 = useScramble("LUAU.", go, reduced);

  return (
    <section id="top" className="relative overflow-hidden pt-28 lg:pt-36">
      {/* floating Luau fragments */}
      <div className="pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="true">
        {FLOATERS.map((f) => (
          <span
            key={f.text}
            className={`floaty absolute font-mono text-[12px] font-semibold ${f.color}`}
            style={{ top: f.top, left: f.left, "--rot": f.rot, "--dur": f.dur } as CSSProperties}
          >
            {f.text}
          </span>
        ))}
      </div>

      <div className="wrap relative grid items-center gap-12 pb-16 lg:grid-cols-[0.92fr_1.08fr] lg:gap-10 lg:pb-24">
        <div>
          <div className="mb-6 flex flex-wrap gap-2">
            <Chip>v2.4.1 · Studio plugin</Chip>
            <Chip tone="mint">0 tokens used</Chip>
            <Chip tone="dim">no API key</Chip>
          </div>

          <h1 className="font-display text-[31px] font-extrabold leading-[1.06] tracking-tight text-fog sm:text-[44px] xl:text-[56px]">
            <span className="block whitespace-pre">{l1}</span>
            <span className="block whitespace-pre">{l2}</span>
            <span className="block whitespace-pre text-amber drop-shadow-[0_0_28px_rgba(255,180,84,0.35)]">{l3}</span>
          </h1>

          <p className="mt-6 max-w-[46ch] text-[15.5px] leading-relaxed text-mute">
            LuauForge lives <em className="not-italic text-fog">inside</em> Roblox Studio as a plugin — it reads your DataModel,
            writes strict-typed Luau, and inserts scripts straight into your Explorer with full undo. Completely free.
            No tokens, no keys, no invoices. <span className="text-amber">Ever.</span>
          </p>

          <div className="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="#install"
              className="group inline-flex items-center gap-2.5 rounded-md bg-amber px-6 py-3.5 text-[14.5px] font-bold text-ink-950 transition-all duration-200 hover:bg-fog hover:shadow-[0_0_36px_rgba(255,180,84,0.4)] active:scale-[0.97]"
            >
              Install the plugin — free
              <ArrowRight size={17} className="transition-transform duration-200 group-hover:translate-x-1.5" />
            </a>
            <a
              href="#library"
              className="inline-flex items-center gap-2 rounded-md border border-line px-6 py-3.5 text-[14.5px] font-semibold text-mute transition-all duration-200 hover:border-amber/50 hover:text-fog active:scale-[0.97]"
            >
              Browse the prompt library
            </a>
          </div>

          <p className="mt-8 font-mono text-[11px] uppercase tracking-[0.18em] text-dim">
            Studio 0.645+ <span className="mx-2 text-line">|</span> Windows &amp; macOS <span className="mx-2 text-line">|</span>{" "}
            <span className="text-mint">4.9★</span> Creator Store <span className="mx-2 text-line">|</span> 214k builders
          </p>
        </div>

        <div className="relative z-10">
          <StudioDemo />
        </div>
      </div>
    </section>
  );
}
